{
  "name": "@captains-chest/material-symbols-rounded-icons-filled",
  "version": "2.2.2",
  "description": "Standalone Angular Material Symbols Rounded filled icon components with embedded SVG templates.",
  "license": "MIT",
  "author": "CaptainDuckay <hello@captains-chest.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/captains-chest/material-symbols-rounded-icons.git",
    "directory": "projects/material-symbols-rounded-icons-filled"
  },
  "homepage": "https://icons.captains-chest.com",
  "bugs": {
    "url": "https://github.com/captains-chest/material-symbols-rounded-icons/issues"
  },
  "keywords": [
    "angular",
    "icons",
    "material symbols",
    "svg",
    "standalone components",
    "filled"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "fesm2022/*.mjs",
    "esm2022/**/*.js",
    "esm2022/**/*.d.ts",
    "types/**/*.d.ts",
    "README.md",
    "LICENSE",
    "LICENSE-THIRD-PARTY.md",
    "package.json"
  ],
  "exports": {
    "./*": {
      "types": "./esm2022/lib/icons/generated/*.icon.d.ts",
      "default": "./esm2022/lib/icons/generated/*.icon.js"
    }
  },
  "peerDependencies": {
    "@angular/common": ">=17.0.0",
    "@angular/core": ">=17.0.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": false
}
